{
  "name": "iacuc-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node init && npm run start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "dev:server": "node init && npm run dev --workspace=server",
    "dev:client": "node init && npm run dev --workspace=client",
    "build:client": "node init && npm run build --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "test:e2e": "playwright test --config e2e/playwright.config.mjs",
    "typecheck": "npm run typecheck --workspace=client"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
