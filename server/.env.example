PORT=4000
DB_PATH=./data/iacuc.db
CLIENT_ORIGIN=http://localhost:5173

# Production / hosted database (Supabase Postgres). When set, the server uses
# Postgres instead of SQLite (DB_PATH is ignored).
#
# Supabase pooler format (verified working 2026-08-06):
#   postgresql://postgres.<project-ref>:<url-encoded-password>@<ip>:5432/postgres?sslmode=require&uselibpqcompat=true
# Three gotchas that break the URL you copy out of the Supabase dashboard:
#   1. The pooler user is `postgres.<project-ref>`, NOT `postgres`.
#   2. Special characters in the password must be URL-encoded (`@` -> %40).
#   3. `db.<ref>.supabase.co` resolves to an IPv6-only address on some
#      networks; if you can't reach it, use the pooler's IPv4 address with
#      `?sslmode=require&uselibpqcompat=true` (pg aliases `require` -> `verify-full`,
#      so without `uselibpqcompat=true` the TLS cert (issued for the hostname)
#      fails against an IP).
# DATABASE_URL=postgresql://postgres.<project-ref>:password@<ip>:5432/postgres?sslmode=require&uselibpqcompat=true
